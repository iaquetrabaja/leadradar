# AI provider — set ONE of these (and scoring.provider in config.yaml)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# LLM_API_KEY=        # for scoring.provider: openai_compatible (OpenRouter, Groq, Ollama…)

# Telegram (create a bot with @BotFather, then run `leadradar telegram-setup`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — better search coverage (pick the provider in config.yaml)
SERPER_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=

# Optional — Reddit API, only if you already have credentials (self-service signup closed in 2025)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional — other channels
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
